# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Filled in by: cd backend && uv run python scripts/register_webhook.py https://<public-host>
PAYPAL_WEBHOOK_ID=

# AI (Gemini, https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-lite-latest

# Postgres
DATABASE_URL=postgresql://localhost:5432/checkout_guard

# Dashboard login + secrets (change these for any deployed demo)
ADMIN_PASSWORD=guard-demo
SESSION_SECRET=change-me-to-a-long-random-string
SHOP_API_KEY=change-me-shop-key

# Demo controls (/demo/*): labelled simulator + seeded history
SIMULATOR_ENABLED=true
