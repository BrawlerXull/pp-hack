# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Filled in by: cd backend && uv run python scripts/register_webhook.py https://<public-host>
PAYPAL_WEBHOOK_ID=

# AI (Gemini, https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional second key (another project's quota), used only after every model failed on the first key.
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-lite-latest
# false: never call Gemini. Incidents get the rules fallback labelled "AI disabled" (policy R3 family: no
# refunds without an AI verdict) and reports use their templates. Useful with no key or no quota left.
AI_ENABLED=true

# Postgres
DATABASE_URL=postgresql://localhost:5432/checkout_guard

# development | production. production refuses to start with the demo ADMIN_PASSWORD, SESSION_SECRET
# (needs 32+ random characters) or SHOP_API_KEY below.
ENVIRONMENT=development

# Dashboard login + secrets (change these for any deployed demo)
ADMIN_PASSWORD=guard-demo
SESSION_SECRET=change-me-to-a-long-random-string
SHOP_API_KEY=change-me-shop-key

# Optional: also push each owner alert to a Slack incoming webhook or an ntfy topic URL (https://ntfy.sh/<topic>)
NOTIFY_WEBHOOK_URL=

# Public URL of the shop frontend (3-D Secure return/cancel pages for card orders)
PUBLIC_APP_URL=http://localhost:3000

# Demo controls (/demo/*): labelled simulator + seeded history
SIMULATOR_ENABLED=true

# Worker cadence: a detector pass every DETECT_INTERVAL_S seconds. An open incident's AI verdict is re-asked
# when something material changed and REASSESS_INTERVAL_S has passed (a new trigger after 30 s already);
# after an AI failure the retry waits 1x, 2x, then 4x REASSESS_INTERVAL_S (app/incidents/cadence.py)
DETECT_INTERVAL_S=5
REASSESS_INTERVAL_S=120

# AG Studio licence key for the Investigate page (frontend build). Optional: without it AG Studio runs as a
# trial with a watermark. AG Grid's hackathon trial lasts 45 days: activate it no earlier than Nov 1 so it
# covers judging (until Dec 15).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
